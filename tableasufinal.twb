      <column caption='Day of week text' datatype='string' name='[Calculation_1984961564369326085]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE [Calculation_1984961564369227780]&#13;&#10;when &apos;1&apos; then &apos;M&apos;&#13;&#10;when &apos;2&apos; then &apos;Tu&apos;&#13;&#10;when &apos;3&apos; then &apos;W&apos;&#13;&#10;when &apos;4&apos; then &apos;Th&apos;&#13;&#10;when &apos;5&apos; then &apos;F&apos;&#13;&#10;when &apos;6&apos; then &apos;Sa&apos;&#13;&#10;when &apos;7&apos; then &apos;Su&apos; &#13;&#10;END' />
