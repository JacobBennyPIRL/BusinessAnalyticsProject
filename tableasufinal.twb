    <worksheet name='Scatterplot'>
      <layout-options>
        <title>
          <formatted-text>
            <run>Ridership vs Ride length by duration</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='cycletrip (fullcycle)' name='federated.160qfgb01nihr519e3w9h17gue71' />
          </datasources>
          <datasource-dependencies datasource='federated.160qfgb01nihr519e3w9h17gue71'>
            <column caption='Trip Duration' datatype='integer' name='[Calculation_1984961564368609280]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='DATEDIFF(&apos;minute&apos;, [started_at], [ended_at])' />
            </column>
            <column caption='Times of day' datatype='string' name='[Calculation_1984961564385771539]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;,[started_at])&gt; 18 THEN &quot;Evening&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[started_at])&gt; 12 THEN &quot;Afternoon&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[started_at])&gt; 6 THEN &quot;Morning&quot;&#13;&#10;ELSE &quot;Early Morning&quot;&#13;&#10;END' />
            </column>
            <column caption='weekday' datatype='string' name='[Calculation_1984961564387176468]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&quot;weekday&quot;,[started_at])' />
            </column>
            <column caption='Month' datatype='string' name='[Calculation_2510475346018172933]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='DATENAME(&apos;month&apos;, [started_at])' />
            </column>
            <column datatype='string' name='[Member Casual (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[member_casual]' new-bin='true' />
            </column>
            <column-instance column='[Calculation_1984961564368609280]' derivation='Avg' name='[avg:Calculation_1984961564368609280:qk]' pivot='key' type='quantitative' />
            <column-instance column='[ride_id]' derivation='Count' name='[cnt:ride_id:qk]' pivot='key' type='quantitative' />
            <column caption='Ended At' datatype='datetime' name='[ended_at]' role='dimension' type='ordinal' />
            <column caption='Member Casual' datatype='string' name='[member_casual]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1984961564385771539]' derivation='None' name='[none:Calculation_1984961564385771539:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_2510475346018172933]' derivation='None' name='[none:Calculation_2510475346018172933:nk]' pivot='key' type='nominal' />
            <column-instance column='[start_station_name]' derivation='None' name='[none:start_station_name:nk]' pivot='key' type='nominal' />
            <column caption='Ride Id' datatype='string' name='[ride_id]' role='dimension' type='nominal' />
            <column caption='Start Station Name' datatype='string' name='[start_station_name]' role='dimension' type='nominal' />
            <column caption='Started At' datatype='datetime' name='[started_at]' role='dimension' type='ordinal' />
            <column datatype='string' name='[weekday (group)]' role='dimension' type='nominal'>
              <calculation class='categorical-bin' column='[Calculation_1984961564387176468]' new-bin='true'>
                <bin default-name='false' value='&quot;weekday&quot;'>
                  <value>&quot;Friday&quot;</value>
                  <value>&quot;Monday&quot;</value>
                  <value>&quot;Thursday&quot;</value>
                  <value>&quot;Tuesday&quot;</value>
                  <value>&quot;Wednesday&quot;</value>
                </bin>
                <bin default-name='false' value='&quot;weekend&quot;'>
                  <value>&quot;Saturday&quot;</value>
                  <value>&quot;Sunday&quot;</value>
                </bin>
              </calculation>
            </column>
