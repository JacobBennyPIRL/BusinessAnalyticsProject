      <column caption='Times of day' datatype='string' name='[Calculation_1984961564385771539]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATEPART(&apos;hour&apos;,[started_at])&gt; 18 THEN &quot;Evening&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[started_at])&gt; 12 THEN &quot;Afternoon&quot;&#13;&#10;ELSEIF DATEPART(&apos;hour&apos;,[started_at])&gt; 6 THEN &quot;Morning&quot;&#13;&#10;ELSE &quot;Early Morning&quot;&#13;&#10;END' />
