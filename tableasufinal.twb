      <column caption='Trip bins' datatype='string' name='[Calculation_1984961564369465350]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1984961564368609280] &gt;= 0 and [Calculation_1984961564368609280] &lt;= 10 then   &apos;0-10&apos;&#13;&#10;ELSEIF [Calculation_1984961564368609280] &gt; 10 and [Calculation_1984961564368609280] &lt;= 15 then   &apos;11-15&apos;&#13;&#10;ELSEIF [Calculation_1984961564368609280] &gt; 15 and [Calculation_1984961564368609280] &lt;= 30 then   &apos;16-30&apos;&#13;&#10;ELSEIF [Calculation_1984961564368609280] &gt; 30 and [Calculation_1984961564368609280] &lt;= 60 then   &apos;31-60&apos;&#13;&#10;ELSE &apos;&gt; than 60&apos; &#13;&#10;END' />
